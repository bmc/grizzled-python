source .venv/bin/activate
export PATH=$(pwd)/.venv/bin:$PATH
# Use ${PYTHONPATH:+:$PYTHONPATH} rather than a bare ":$PYTHONPATH". If
# PYTHONPATH is unset or empty, the latter leaves a trailing colon, and an
# empty PYTHONPATH entry means "the current directory" -- which lets any
# local directory (test/collections, test/os, ...) shadow a standard
# library module.
export PYTHONPATH="$(pwd)${PYTHONPATH:+:$PYTHONPATH}"
